AKB_DATABASE_URL=postgresql+psycopg://akb_app:replace-me@127.0.0.1:55471/akb
AKB_WORKER_DATABASE_URL=postgresql+psycopg://akb_worker:replace-me@127.0.0.1:55471/akb
AKB_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:replace-me@127.0.0.1:55471/akb
AKB_STORAGE_DIR=./data/objects
# Optional private Cloudreve gateway; run scripts/setup_cloudreve.py first.
# AKB_CLOUDREVE_CREDENTIALS=/absolute/workspace/secrets/cloudreve.json
# Native file UI connection; each user pairs their own drive with a five-minute linking code.
AKB_NATIVE_CLOUDREVE_URL=http://127.0.0.1:5878
AKB_NATIVE_ORIGIN=http://localhost:5878
AKB_NATIVE_SYNC_ENABLED=false
AKB_API_PORT=5876
AKB_WEB_ORIGIN=http://localhost:5877
AKB_COOKIE_SECURE=false
AKB_UPLOAD_LIMIT=2147483648
AKB_DEFAULT_QUOTA_BYTES=10737418240
AKB_DISK_RESERVE_BYTES=268435456
# Local stdio MCP only; the shared remote assistant obtains OAuth grants instead.
AKB_API_URL=http://127.0.0.1:5876
AKB_TOKEN=

# Active semantic engine: Tencent storage/index + WorkBuddy model execution.
AKB_KNOWLEDGE_ENGINE=tencent
# Optional shared assistant: set a real HTTPS root origin after deployment.
# Empty keeps the existing local stdio package and startup behavior.
AKB_ASSISTANT_PUBLIC_ORIGIN=

# Stable identity cutover. Configure a real provider before enabling required mode.
# Preserve existing spaces: bind an external account from their authorized session first.
AKB_IDENTITY_REQUIRED=false
# Keep the application secret in a private, server-side JSON file (never in a Skill).
# AKB_IDENTITY_PROVIDERS_FILE=/app/secrets/identity-providers.json
# Optional short native callback schemes; reverse-domain schemes also work (RFC 8252).
AKB_ASSISTANT_REDIRECT_SCHEMES=["workbuddy","codebuddy"]

# Optional external WorkBuddy executor backend (explicit cutover required).
# AKB_KNOWLEDGE_ENGINE=weknora
# AKB_WEKNORA_URL=http://127.0.0.1:5881
# AKB_WEKNORA_SECRETS_DIR=./secrets/weknora
# AKB_AGENT_TASK_LEASE_SECONDS=900
