+package externalmode
+
+import "testing"
+
+func TestEnvelopeIndexHasRealWhitespace(t *testing.T) {
+	t.Setenv("WEKNORA_EXTERNAL_EXECUTOR", "workbuddy")
+	source := `{"body":"line one\nQingzhu Project\nA\tB"}`
+	if got := SearchText(source); got != "line one\nQingzhu Project\nA\tB" {
+		t.Fatalf("unexpected index text: %q", got)
+	}
+	t.Setenv("WEKNORA_EXTERNAL_EXECUTOR", "")
+	if SearchText(source) != source {
+		t.Fatal("normal mode must not decode")
+	}
+}
