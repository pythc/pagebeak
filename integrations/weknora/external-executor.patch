+// Package externalmode enforces the Zhixu external WorkBuddy executor contract.
+package externalmode
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+)
+
+func Enabled() bool { return os.Getenv("WEKNORA_EXTERNAL_EXECUTOR") == "workbuddy" }
+
+var ErrDisabled = errors.New("server AI inference disabled: execute semantic work in WorkBuddy")
+
+// SearchText unwraps only our transport envelope for indexing. The immutable
+// metadata retains the envelope for exact round-trip reads. Indexing JSON escape
+// sequences would turn a line-starting English word into a different token.
+func SearchText(content string) string {
+	if !Enabled() {
+		return content
+	}
+	var envelope struct {
+		Body *string `json:"body"`
+	}
+	if json.Unmarshal([]byte(content), &envelope) == nil && envelope.Body != nil {
+		return *envelope.Body
+	}
+	return content
+}
