+package service
+import (
+ "context"
+ "errors"
+ "testing"
+ "github.com/Tencent/WeKnora/internal/externalmode"
+)
+func TestExternalExecutorBlocksInferenceBeforeModelLookup(t *testing.T) {
+ t.Setenv("WEKNORA_EXTERNAL_EXECUTOR", "workbuddy")
+ s := &modelService{}
+ ctx := context.Background()
+ if _,e:=s.GetChatModel(ctx,"should-never-load"); !errors.Is(e,externalmode.ErrDisabled){t.Fatal(e)}
+ if _,e:=s.GetRerankModel(ctx,"should-never-load"); !errors.Is(e,externalmode.ErrDisabled){t.Fatal(e)}
+ if _,e:=s.GetVLMModel(ctx,"should-never-load"); !errors.Is(e,externalmode.ErrDisabled){t.Fatal(e)}
+ if _,e:=s.GetASRModel(ctx,"should-never-load"); !errors.Is(e,externalmode.ErrDisabled){t.Fatal(e)}
+ e,err:=s.GetEmbeddingModel(ctx,"");if err!=nil{t.Fatal(err)}
+ if e.GetDimensions()!=0{t.Fatal("fake vector dimensions")}
+ if _,err=e.Embed(ctx,"secret");!errors.Is(err,externalmode.ErrDisabled){t.Fatal(err)}
+}
